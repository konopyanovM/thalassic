{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@thalassic/ui": ["./libs/ui/src/index.ts"],
      "@thalassic/ui/charts": ["./libs/ui/charts/src/index.ts"],
      "@thalassic/ui/media": ["./libs/ui/media/src/index.ts"],
      "@thalassic/ui/fontawesome": ["./libs/ui/fontawesome/src/index.ts"],
      "@thalassic/ui/rich-text-editor": ["./libs/ui/rich-text-editor/src/index.ts"],
      "@thalassic/core": ["./libs/core/src/index.ts"],
      "@thalassic/themes": ["./libs/themes/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
