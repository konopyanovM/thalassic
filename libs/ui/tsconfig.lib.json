{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "types": []
  },
  "include": [
    "src/**/*.ts",
    "charts/src/**/*.ts",
    "fontawesome/src/**/*.ts",
    "rich-text-editor/src/**/*.ts",
    "media/src/**/*.ts"
  ],
  "exclude": ["**/*.spec.ts", "**/*.test.ts", "**/*.stories.ts", "**/*.stories.js"]
}
